%% REV-012 segment case seg60_m1tt: 895 rows x 1 x Propagate 60.0 s.
GMAT Earth.Mu = 398600.4418;
GMAT Earth.EquatorialRadius = 6378.137;
Create Spacecraft Sat;
GMAT Sat.DateFormat = TTGregorian;
GMAT Sat.Epoch = '01 Jan 2026 00:00:00.000';
GMAT Sat.CoordinateSystem = EarthMJ2000Eq;
GMAT Sat.DisplayStateType = Cartesian;
GMAT Sat.X = 6628.137;
GMAT Sat.Y = 0.0;
GMAT Sat.Z = 0.0;
GMAT Sat.VX = 0.0;
GMAT Sat.VY = 4.8169050670943;
GMAT Sat.VZ = 6.077421678863729;
Create ForceModel FM;
GMAT FM.CentralBody = Earth;
GMAT FM.PrimaryBodies = {};
GMAT FM.PointMasses = {Earth};
GMAT FM.Drag = None;
GMAT FM.SRP = Off;
GMAT FM.RelativisticCorrection = Off;
GMAT FM.ErrorControl = RSSStep;
Create Propagator P;
GMAT P.FM = FM;
GMAT P.Type = PrinceDormand78;
GMAT P.InitialStepSize = 60.0;
GMAT P.Accuracy = 1e-13;
GMAT P.MinStep = 0;
GMAT P.MaxStep = 60.0;
GMAT P.MaxStepAttempts = 50;
GMAT P.StopIfAccuracyIsViolated = true;
Create ReportFile R;
GMAT R.Filename = '__OUT__';
GMAT R.Precision = 17;
GMAT R.WriteHeaders = false;
GMAT R.LeftJustify = On;
GMAT R.ZeroFill = Off;
GMAT R.FixedWidth = true;
GMAT R.Delimiter = ' ';
GMAT R.ColumnWidth = 26;
Create Variable I J ElapsedS A0 DA OFFTT;
BeginMissionSequence;
A0 = Sat.A1ModJulian;
ElapsedS = 0;
DA = 0;
OFFTT = (Sat.TTModJulian - Sat.A1ModJulian) * 86400;
Report R ElapsedS Sat.ElapsedSecs Sat.A1ModJulian DA OFFTT Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ;
For I = 1:895;
   Propagate P(Sat) {Sat.ElapsedSecs = 60.0};
   ElapsedS = 60.0 * I;
   DA = Sat.A1ModJulian - A0;
   OFFTT = (Sat.TTModJulian - Sat.A1ModJulian) * 86400;
   Report R ElapsedS Sat.ElapsedSecs Sat.A1ModJulian DA OFFTT Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ;
EndFor;

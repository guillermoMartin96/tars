%% REV-012 burn case burn_a50000_10: coast 600.0 s, burn 10.0 s, coast to 53700.0 s.
GMAT Earth.Mu = 398600.4418;
GMAT Earth.EquatorialRadius = 6378.137;
Create Spacecraft Sat;
GMAT Sat.DateFormat = A1ModJulian;
GMAT Sat.Epoch = '50000.5';
GMAT Sat.CoordinateSystem = EarthMJ2000Eq;
GMAT Sat.DisplayStateType = Cartesian;
GMAT Sat.X = 6628.137;
GMAT Sat.Y = 0.0;
GMAT Sat.Z = 0.0;
GMAT Sat.VX = 0.0;
GMAT Sat.VY = 4.8169050670943;
GMAT Sat.VZ = 6.077421678863729;
GMAT Sat.DryMass = 1000;
GMAT Sat.Tanks = {Tank1};
GMAT Sat.Thrusters = {Eng1};
Create ChemicalTank Tank1;
GMAT Tank1.AllowNegativeFuelMass = false;
GMAT Tank1.FuelMass = 300;
Create ChemicalThruster Eng1;
GMAT Eng1.CoordinateSystem = Local;
GMAT Eng1.Origin = Earth;
GMAT Eng1.Axes = VNB;
GMAT Eng1.ThrustDirection1 = 1;
GMAT Eng1.ThrustDirection2 = 0;
GMAT Eng1.ThrustDirection3 = 0;
GMAT Eng1.DutyCycle = 1;
GMAT Eng1.ThrustScaleFactor = 1;
GMAT Eng1.DecrementMass = true;
GMAT Eng1.Tank = {Tank1};
GMAT Eng1.MixRatio = [1];
GMAT Eng1.GravitationalAccel = 9.80665;
GMAT Eng1.C1 = 490;
GMAT Eng1.K1 = 312;
Create FiniteBurn FB;
GMAT FB.Thrusters = {Eng1};
Create ForceModel FM;
GMAT FM.CentralBody = Earth;
GMAT FM.PrimaryBodies = {};
GMAT FM.PointMasses = {Earth};
GMAT FM.Drag = None;
GMAT FM.SRP = Off;
GMAT FM.RelativisticCorrection = Off;
GMAT FM.ErrorControl = RSSStep;
Create Propagator P;
GMAT P.FM = FM;
GMAT P.Type = PrinceDormand78;
GMAT P.InitialStepSize = 10.0;
GMAT P.Accuracy = 1e-13;
GMAT P.MinStep = 0;
GMAT P.MaxStep = 60.0;
GMAT P.MaxStepAttempts = 50;
GMAT P.StopIfAccuracyIsViolated = true;
Create ReportFile R;
GMAT R.Filename = '__OUT__';
GMAT R.Precision = 17;
GMAT R.WriteHeaders = false;
GMAT R.LeftJustify = On;
GMAT R.ZeroFill = Off;
GMAT R.FixedWidth = true;
GMAT R.Delimiter = ' ';
GMAT R.ColumnWidth = 26;
Create ReportFile S;
GMAT S.Filename = '__STEPS__';
GMAT S.Precision = 17;
GMAT S.WriteHeaders = false;
GMAT S.LeftJustify = On;
GMAT S.ZeroFill = Off;
GMAT S.FixedWidth = true;
GMAT S.Delimiter = ' ';
GMAT S.ColumnWidth = 26;
GMAT S.Add = {Sat.A1ModJulian, Sat.TotalMass};
BeginMissionSequence;
Toggle S Off;
Report R Sat.A1ModJulian Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ Sat.TotalMass;
Propagate P(Sat) {Sat.ElapsedSecs = 600.0};
Report R Sat.A1ModJulian Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ Sat.TotalMass;
Toggle S On;
BeginFiniteBurn FB(Sat);
Propagate P(Sat) {Sat.ElapsedSecs = 10.0};
EndFiniteBurn FB(Sat);
Toggle S Off;
Report R Sat.A1ModJulian Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ Sat.TotalMass;
Propagate P(Sat) {Sat.ElapsedSecs = 53090.0};
Report R Sat.A1ModJulian Sat.ElapsedSecs Sat.EarthMJ2000Eq.X Sat.EarthMJ2000Eq.Y Sat.EarthMJ2000Eq.Z Sat.EarthMJ2000Eq.VX Sat.EarthMJ2000Eq.VY Sat.EarthMJ2000Eq.VZ Sat.TotalMass;

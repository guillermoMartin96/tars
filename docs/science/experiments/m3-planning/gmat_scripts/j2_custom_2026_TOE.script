GMAT Earth.Mu = 398600.4418;
GMAT Earth.EquatorialRadius = 6378.137;
Create CoordinateSystem TOE;
GMAT TOE.Origin = Earth;
GMAT TOE.Axes = TOEEq;
GMAT TOE.Epoch = 31041.499627897938;
Create Spacecraft Sat;
GMAT Sat.DateFormat = TTGregorian;
GMAT Sat.Epoch = '01 Jan 2026 00:00:00.000';
GMAT Sat.CoordinateSystem = TOE;
GMAT Sat.DisplayStateType = Cartesian;
GMAT Sat.X = 6628.137;
GMAT Sat.Y = 0.0;
GMAT Sat.Z = 0.0;
GMAT Sat.VX = 0.0;
GMAT Sat.VY = 4.8169050670943;
GMAT Sat.VZ = 6.077421678863729;
GMAT Sat.DryMass = 850.0;
GMAT Sat.DragArea = 15.0;
GMAT Sat.Cd = 2.2;
Create ForceModel FM;
GMAT FM.CentralBody = Earth;
GMAT FM.PrimaryBodies = {Earth};
GMAT FM.PointMasses = {};
GMAT FM.GravityField.Earth.Degree = 2;
GMAT FM.GravityField.Earth.Order = 0;
GMAT FM.GravityField.Earth.PotentialFile = '<tmp>/j2.cof';
GMAT FM.GravityField.Earth.TideModel = 'None';
GMAT FM.SRP = Off;
GMAT FM.RelativisticCorrection = Off;
GMAT FM.ErrorControl = RSSStep;
GMAT FM.Drag = None;
Create Propagator Prop;
GMAT Prop.FM = FM;
GMAT Prop.Type = PrinceDormand78;
GMAT Prop.InitialStepSize = 60.0;
GMAT Prop.Accuracy = 1e-13;
GMAT Prop.MinStep = 0;
GMAT Prop.MaxStep = 60.0;
GMAT Prop.MaxStepAttempts = 50;
Create ReportFile R;
GMAT R.Filename = '<tmp>/j2_custom_2026_TOE_report.txt';
GMAT R.Precision = 16;
GMAT R.WriteHeaders = false;
BeginMissionSequence;
Report R Sat.ElapsedSecs Sat.TOE.X Sat.TOE.Y Sat.TOE.Z Sat.TOE.VX Sat.TOE.VY Sat.TOE.VZ;
Propagate Prop(Sat) {Sat.ElapsedSecs = 53700.0};
Report R Sat.ElapsedSecs Sat.TOE.X Sat.TOE.Y Sat.TOE.Z Sat.TOE.VX Sat.TOE.VY Sat.TOE.VZ;

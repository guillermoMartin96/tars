Create ForceModel FMD;
GMAT FMD.CentralBody = Earth;
GMAT FMD.PrimaryBodies = {Earth};
GMAT FMD.GravityField.Earth.Degree = 0;
GMAT FMD.GravityField.Earth.Order = 0;
GMAT FMD.GravityField.Earth.PotentialFile = '<RUN>/t0.cof';
GMAT FMD.SRP = Off;
GMAT FMD.Drag.AtmosphereModel = Exponential;
GMAT FMD.Drag.InputFile = '<GMAT>/data/atmosphere/earth/EarthExponentialAtmosphereData.txt';
Create ForceModel FMN;
GMAT FMN.CentralBody = Earth;
GMAT FMN.PrimaryBodies = {Earth};
GMAT FMN.GravityField.Earth.Degree = 0;
GMAT FMN.GravityField.Earth.Order = 0;
GMAT FMN.GravityField.Earth.PotentialFile = '<RUN>/t0.cof';

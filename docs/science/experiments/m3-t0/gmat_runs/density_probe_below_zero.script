Create Propagator PD;
GMAT PD.FM = FMD;
GMAT PD.Type = PrinceDormand78;
GMAT PD.InitialStepSize = 0.001;
GMAT PD.Accuracy = 1e-13;
GMAT PD.MinStep = 0;
GMAT PD.MaxStep = 0.001;

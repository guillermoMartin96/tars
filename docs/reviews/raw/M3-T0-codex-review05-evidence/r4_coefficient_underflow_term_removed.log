        for x0 in (
            m.A_WGS84 + float(o.top_band_height(D(2) ** -1022)),
            coefficient_flip_x(mass),
            m.A_WGS84 + float(o.top_band_height(TINY / 2)),
        ):
            xs = [x0]
            for _ in range(40):

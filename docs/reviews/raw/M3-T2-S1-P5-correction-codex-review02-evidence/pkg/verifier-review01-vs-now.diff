+def coverage_ok(x):
+    """R01: the list's coverage matches the I-48 expectation exactly."""
+    want = EXPECTED_SIBLING_COVERAGE.get(x["path"])
+    cov = x["covered_by_sibling_entry"]
+    if want is True:
+        return (cov is not None and cov["matches"] and x["sibling_manifest_p5a"] is True
+                and len(x["covered_by_any_committed_SHA256SUMS"]) >= 1)
+    if want is False:
+        return cov is None and not x["covered_by_any_committed_SHA256SUMS"]
+    return False
+
